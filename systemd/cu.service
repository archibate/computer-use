[Unit]
Description=Computer-use daemon for an isolated X11 desktop
BindsTo=cu-display.service
After=cu-display.service

[Service]
Type=simple
Environment=DISPLAY=:99
UnsetEnvironment=WAYLAND_DISPLAY XDG_SESSION_TYPE
ExecStart=%h/.local/bin/cu daemon --backend x11 --display :99
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
UpheldBy=cu-display.service
